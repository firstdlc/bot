import asyncio
import logging
from aiogram import Bot, Dispatcher, F, Router
from aiogram.filters import CommandStart
from aiogram.types import (
    Message, CallbackQuery,
    InlineKeyboardMarkup, InlineKeyboardButton,
    ChatMemberAdministrator, ChatMemberOwner,
)
from aiogram.enums import ContentType, ChatMemberStatus

# ==================== НАСТРОЙКИ ====================
BOT_TOKEN  = "8829161654:AAEW5334Gz8xl4HW4BxRulMDSFcRMcJhUrU"
GROUP_ID   = -1004451258124          
CHANNEL_ID = "@pozoryalta1"            

WELCOME_TEXT = (
    "👋 Добро пожаловать в предложку канала!\n\n"
    "Отправьте сюда видео, фото, новость или кругляшок, "
    "которое хотите предложить для публикации.\n\n"
    "Бот передаст его администраторам на модерацию!"
)

MSG_SUBMITTED   = "✅ Спасибо! Ваше предложение отправлено на модерацию."
MSG_APPROVED    = "✅ Ваше предложение опубликовано в канале! Спасибо."
MSG_REJECTED    = "❌ К сожалению, ваше предложение было отклонено модераторами."
MSG_SEND_FAIL   = "⚠️ Не удалось отправить заявку. Попробуйте позже."
# ===================================================

logging.basicConfig(level=logging.INFO)
log = logging.getLogger(__name__)

bot = Bot(token=BOT_TOKEN)
dp = Dispatcher()
router = Router()
dp.include_router(router)

# message_id пересланного в группу сообщения -> (chat_id автора, message_id оригинала, user_id автора)
pending: dict[int, tuple[int, int, int]] = {}


async def is_moderator(user_id: int) -> bool:
    """Проверяет, является ли пользователь админом/владельцем группы."""
    try:
        member = await bot.get_chat_member(chat_id=GROUP_ID, user_id=user_id)
    except Exception as e:
        log.warning("get_chat_member failed: %s", e)
        return False
    return (
        isinstance(member, (ChatMemberAdministrator, ChatMemberOwner))
        or member.status in (ChatMemberStatus.ADMINISTRATOR, ChatMemberStatus.CREATOR)
    )


async def notify(user_id: int, text: str) -> None:
    """Пытается отправить уведомление пользователю, не ломая основной поток."""
    try:
        await bot.send_message(user_id, text)
    except Exception as e:
        log.warning("Не удалось уведомить пользователя %s: %s", user_id, e)


@router.message(CommandStart())
async def start(message: Message):
    await message.answer(WELCOME_TEXT)


@router.message(
    F.chat.type == "private",
    F.content_type.in_({
        ContentType.TEXT,
        ContentType.PHOTO,
        ContentType.VIDEO,
        ContentType.VIDEO_NOTE,
        ContentType.ANIMATION,
        ContentType.DOCUMENT,
        ContentType.AUDIO,
    }),
)
async def handle_suggestion(message: Message):
    # Пересылаем в группу модераторов
    try:
        forwarded = await message.forward(chat_id=GROUP_ID)
    except Exception as e:
        log.exception("Не удалось переслать в группу: %s", e)
        await message.answer(MSG_SEND_FAIL)
        return

    pending[forwarded.message_id] = (
        message.chat.id,
        message.message_id,
        message.from_user.id,
    )

    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(text="✅ Опубликовать", callback_data=f"pub:{forwarded.message_id}"),
        InlineKeyboardButton(text="❌ Отклонить",   callback_data=f"rej:{forwarded.message_id}"),
    ]])

    author = message.from_user.full_name
    username = f"@{message.from_user.username}" if message.from_user.username else "—"

    await bot.send_message(
        GROUP_ID,
        f"📩 Новое предложение\n"
        f"От: {author} ({username})\n"
        f"ID: <code>{message.from_user.id}</code>",
        parse_mode="HTML",
        reply_to_message_id=forwarded.message_id,
        reply_markup=kb,
    )

    await message.answer(MSG_SUBMITTED)


@router.callback_query(F.data.startswith("pub:"))
async def approve(callback: CallbackQuery):
    if not await is_moderator(callback.from_user.id):
        await callback.answer("Недостаточно прав", show_alert=True)
        return

    fwd_id = int(callback.data.split(":")[1])
    origin = pending.pop(fwd_id, None)

    if not origin:
        await callback.message.edit_text(
            "⚠️ Исходное сообщение не найдено (возможно, бот перезапускался)."
        )
        await callback.answer()
        return

    chat_id, msg_id, author_user_id = origin
    try:
        await bot.copy_message(
            chat_id=CHANNEL_ID,
            from_chat_id=chat_id,
            message_id=msg_id,
        )
        await callback.message.edit_text("✅ Опубликовано в канале.")
        await notify(author_user_id, MSG_APPROVED)
    except Exception as e:
        log.exception("Публикация не удалась: %s", e)
        await callback.message.edit_text(
            f"⚠️ Ошибка публикации: <code>{e}</code>", parse_mode="HTML"
        )
    await callback.answer()


@router.callback_query(F.data.startswith("rej:"))
async def reject(callback: CallbackQuery):
    if not await is_moderator(callback.from_user.id):
        await callback.answer("Недостаточно прав", show_alert=True)
        return

    fwd_id = int(callback.data.split(":")[1])
    origin = pending.pop(fwd_id, None)

    if origin:
        _, _, author_user_id = origin
        await notify(author_user_id, MSG_REJECTED)

    await callback.message.edit_text("❌ Предложение отклонено.")
    await callback.answer()


async def main():
    log.info("Бот запущен...")
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
